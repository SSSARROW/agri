ENVIRONMENT=development
DEBUG=true
# Dev database is Supabase Postgres. Get the connection string from the
# Supabase dashboard (Settings -> Database -> Connection string) and
# percent-encode any special characters in the password (@ -> %40, # -> %23).
# Session pooler URL; percent-encode special characters in the password (@ -> %40, # -> %23).
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://agri:agri@localhost:5432/agri
LOG_LEVEL=INFO
# Same Supabase project as DATABASE_URL above, from Project Settings -> API —
# used for Storage (field photos), shared with web/backend's own .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
# Shared with web/backend (same value) so this API can verify its tokens locally.
JWT_SECRET=generate-with-python-c-import-secrets;print(secrets.token_hex(32))
JWT_ALGORITHM=HS256
# Signs batch codes (B-12) — a different secret from JWT_SECRET on purpose.
BATCH_CODE_SECRET=generate-with-python-c-import-secrets;print(secrets.token_hex(32))
